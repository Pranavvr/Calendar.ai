.venv/
.env
token.json
token-from-ec2-backup.json
credentials.json
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.DS_Store

# File-sync duplicates. This working copy lives under Desktop, which is synced,
# and the sync creates byte-identical "name 2.py" copies. pytest collects the
# duplicated test files, which silently inflates the test count.
* 2.*
* 3.*

# Local-only notebook drafts (not for git history).
# Personal learning notes, not project artifacts — ignore the whole class rather
# than listing each one as it appears.
notebooks/*.md

# Claude Code: shared project config IS tracked (.claude/settings.json, agents,
# skills, hooks). Personal overrides are not.
.claude/settings.local.json

# Terraform local state and provider cache
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/.terraform.tfstate.lock.info