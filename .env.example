# OpenAI API key for the LangGraph agent (gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Local Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://cal_ai:cal_ai_local@localhost:5432/cal_ai

# Session JWT signing key — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-bytes-of-random-hex
JWT_TTL_HOURS=168

# Google OAuth client (Web application type) — from Google Cloud Console
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Starlette SessionMiddleware secret (separate from JWT_SECRET; used by Authlib
# for OAuth state/CSRF protection during the redirect dance) — also openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-bytes-of-random-hex

# Encrypts stored Google refresh tokens at the column level. Separate from
# JWT_SECRET on purpose: rotating session signing should not invalidate every
# user's stored calendar authorization.
#
# Generate with:
#   .venv/bin/python -c "from auth.crypto import generate_key; print(generate_key())"
#
# In AWS this comes from Secrets Manager. Rotating it makes existing stored
# tokens undecryptable, and affected users must sign in again.
TOKEN_ENCRYPTION_KEY=replace-me-with-a-generated-fernet-key

# The session cookie is HTTPS-only by default. Local development runs on plain
# HTTP, where a secure cookie is never sent, so turn it off here only.
# Never set this to false in a deployed environment.
COOKIE_SECURE=false
